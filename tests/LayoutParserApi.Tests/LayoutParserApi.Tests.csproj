<Project Sdk="Microsoft.NET.Sdk">

  <!-- Como rodar:  dotnet test                  (pela solution — roda esta suíte)
                    dotnet test tests\LayoutParserApi.Tests\LayoutParserApi.Tests.csproj

       Este projeto ESTÁ na LayoutParserApi.sln desde 2026-08-10 (@lp-devops). Antes ficava de
       fora, e o efeito era um quality gate que mentia: `dotnet test` na solution reportava
       SUCESSO tendo executado ZERO testes.

       O risco que justificava ficar fora era real e foi neutralizado, não ignorado: na raiz do
       repo há um .sln e um .csproj, e o dotnet CLI resolve o comando sem argumento pela SOLUTION
       — o deploy.yml rodava exatamente isso, então entrar na .sln faria o deploy de PRODUÇÃO
       restaurar xUnit e compilar testes. O deploy.yml passou a buildar o .csproj da API
       EXPLICITAMENTE (ver o comentário no step "Build LayoutParserApi"), e o `dotnet test` virou
       step próprio no ci-dev.yml. Produção compila só o que publica; o gate roda no CI de dev. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Sem apphost: evita o erro de CreateAppHost em diretório temporário/máquina de build
         (armadilha conhecida desta máquina, ver harness de QA). O runner do xUnit não precisa
         do executável nativo. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- Issue #90: WebApplicationFactory<Program> para o teste de composition root real
         (ProgramCompositionRootTests). Traz Microsoft.AspNetCore.Mvc.Testing, que já referencia
         o FrameworkReference correto — não conflita com o FrameworkReference herdado via
         ProjectReference da API abaixo. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- A API é um projeto Web (Microsoft.NET.Sdk.Web); o FrameworkReference do
         Microsoft.AspNetCore.App flui por aqui, então os testes enxergam ILogger/IConfiguration
         sem PackageReference extra. -->
    <ProjectReference Include="..\..\LayoutParserApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parser de linha de comando do runner low-code, compilado TAMBÉM aqui (link, não cópia).

         Por que link e não ProjectReference: o runner é net481/x86 (o stack Sysmiddle é 32-bit —
         ver o comentário do PlatformTarget no .csproj dele) e referenciá-lo de um projeto net10.0
         não é possível. O arquivo é puro (só System/System.Collections.Generic, com #nullable
         disable no topo para compilar idêntico nos dois targets), então o que roda no teste é
         exatamente o código que roda no .exe — não uma cópia que pode divergir. -->
    <Compile Include="..\..\tools\LowCodeRunner\RunnerArgs.cs"
             Link="Transformation\RunnerArgs.cs" />

    <!-- Mesmo raciocínio: as regras de documento portadas do MappersHelper (declaração XML e
         pós-processamento NF-e) são puras (System.Xml apenas), então o que a suíte exercita é
         exatamente o que roda no .exe. É aqui que a divergência entre ExecuteMappingDocumentById e
         ExecuteMappingDocument (docs/architecture/decisao-remover-dependencia-appconnector.md §3)
         deixa de ser comentário e vira invariante travada. -->
    <Compile Include="..\..\tools\LowCodeRunner\SysmiddleDocumentRules.cs"
             Link="Transformation\SysmiddleDocumentRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #140: mesmo XSD público (mirror nfephp-org/sped-nfe) já usado como fixture em
         ai/XslSynth.Core.Tests/StructuralResolution/fixtures — copiado aqui (não referenciado por
         caminho relativo cross-projeto) para o teste de wiring ponta-a-ponta do
         FieldMappingCompositionService não depender da localização do outro projeto de teste. -->
    <None Include="StructuralResolution\fixtures\*.xsd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #103 Passo 1: fixture SINTÉTICA (não é o Excel real do dono) que espelha a estrutura
         confirmada em sessão 2026-09-02 contra
         "Layout_NF-e_Mensageria_Envio_ReformaTritutária_v1 - NT 1.50.xlsx" — conteúdo genérico de
         domínio fiscal público (tabela CST), sem nomes de cliente. O arquivo real não entra no
         repo por conter nomes de cliente em outra aba (ver FiscalMappingRuleExtractorTests). -->
    <None Include="Fixtures\Fiscal\*.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
