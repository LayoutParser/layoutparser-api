<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2aefc4e0-99bb-4143-b95b-5a01bf22d27a</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <!-- O MCP (mcp/LayoutParserMcp), o projeto de síntese de IA (ai/XslSynth) e o projeto de
         testes (tests/LayoutParserApi.Tests) são projetos separados aninhados nesta árvore.
         Exclui seus arquivos do glob padrão da API para não colidir no build (Program.cs
         duplicado + tipos de outros pacotes). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);mcp\**;ai\**;.claude\**;tools\**;tests\**</DefaultItemExcludes>
    <LangVersion>preview</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- XML docs viram comentário no Swagger (options.IncludeXmlComments em Program.cs).
         CS1591 ("membro público sem doc") é suprimido: cobrimos endpoints/DTOs expostos,
         não cada membro interno/privado — não faz sentido travar o build por isso. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <!-- ADR M2M (docs/architecture/adr-autenticacao-m2m-e2e-cypress-2026-09-03.md), Parte 1:
         segundo AuthenticationScheme (JWT Bearer) para client credentials via Entra, paralelo ao
         TrustedHeaderAuthenticationHandler existente. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <!-- ADR segregação Decrypt/LowCodeRunner (2026-09-25): resiliência (retry + circuit breaker +
         timeout) do HttpClient do serviço LayoutParserDecrypt — mesmo padrão de degradação
         graciosa já usado para Redis, mas descriptografia é etapa crítica do pipeline (não
         opcional), então o circuito só evita martelar um serviço fora do ar. -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Leitura de PDF (issue #172, orientações de correção XSD): PdfPig, Apache-2.0, mesma
         biblioteca já validada em ai/XslSynth/NtPipeline/PdfSmokeExtractor.cs (protótipo B5 P-2) -
         evita depender de PdfSharp/iTextSharp (AGPL/comercial em versões recentes, ver TODO
         original no XsdValidationService). Não faz OCR (PDFs escaneados como imagem não são
         cobertos). -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Analyzer Roslyn de seguranca estatica (SAST), gratuito e sem infra extra - roda dentro
         do dotnet build normal. Alternativa ao CodeQL/GitHub Advanced Security, que exige
         repo publico ou licenca paga (este repo e privado por decisao de seguranca -
         ver .claude/rules/agent-authority.md). PrivateAssets="all" porque e ferramenta de
         build, nao dependencia de runtime - nao deve propagar para quem referenciar este projeto. -->
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Elasticsearch" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>


  <ItemGroup>
    <!-- Loop RAG (RepairOrchestrator etc.) extraído de ai/XslSynth para classlib compartilhada
         — evita duplicar o loop dentro da API (Issue #40, pathway IA de execute-candidates).
         ai\** continua excluído do glob padrão acima; esta referência é explícita.
         XslSynth.Core ainda é referenciado inteiro (CanonicalDiffer é usado diretamente por
         AiTransformationCandidateService) — puxar Ollama/RAG junto no publish é uma dívida
         conhecida, não corrigida nesta extração (ver
         docs/architecture/design-xslsynth-runtime-e-reversibilidade-2026-08-16.md §1). -->
    <ProjectReference Include="ai\XslSynth.Core\XslSynth.Core.csproj" />
    <!-- Núcleo determinístico (parser DSL→JSON, schema, catálogo de funções, catálogo
         GUID→XPath) sem I/O externo — referência explícita e independente do XslSynth.Core
         acima, para deixar claro que Services/ pode consumir isto sem precisar de Ollama/RAG. -->
    <ProjectReference Include="ai\XslSynth.Contracts\XslSynth.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\Validation\Models\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Base indexada CFOP x tipo de operacao (item 6.1 do dispatch de IA) - embutida
         no assembly para nao depender de caminho de arquivo em disco (resiliente a
         deploy como servico Windows, Docker, etc. - mesmo principio do HintPath acima). -->
    <EmbeddedResource Include="Data\Fiscal\cfop-tabela.csv" />
  </ItemGroup>

</Project>
